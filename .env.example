# Copy to .env. Every setting can live here; agent-mcp.toml is optional.
# Variables mirror the TOML layout with __ between levels:
#   AGENT_MCP__SERVER__<FIELD>             [server]
#   AGENT_MCP__<MODULE>__TOOLS / ENABLED   [modules.<module>]
#   AGENT_MCP__<MODULE>__<FIELD>[__...]    [modules.<module>.settings]
# Values set here override the TOML file; real environment variables override this file.
# Lists are comma-separated (or JSON).

AGENT_MCP__SERVER__TRANSPORT=stdio
# AGENT_MCP__SERVER__AUDIT_LOG=audit.jsonl
# AGENT_MCP__SERVER__HOST=127.0.0.1
# AGENT_MCP__SERVER__PORT=8765
# AGENT_MCP__SERVER__ALLOWED_HOSTS=agent-mcp   # accept only this Host header (compose.yaml sets it)
# In Docker, compose.yaml overrides TRANSPORT/HOST/PORT for the container.

# ---- calendar --------------------------------------------------------------
AGENT_MCP__CALENDAR__TOOLS=calendars,events,event,organizations,schedule

# Google Cloud > Credentials > OAuth client ID > Desktop app
AGENT_MCP__CALENDAR__CLIENT_ID=
AGENT_MCP__CALENDAR__CLIENT_SECRET=
# Filled in by `uv run agent-mcp-google-auth`
AGENT_MCP__CALENDAR__REFRESH_TOKEN=

AGENT_MCP__CALENDAR__TIMEZONE=Europe/Helsinki
AGENT_MCP__CALENDAR__SCHEDULING_CALENDAR=ai scheduling

# One block per organization; the middle part (TKO) becomes its key, lowercased.
AGENT_MCP__CALENDAR__ORGANIZATIONS__TKO__NAME=TKO-äly
AGENT_MCP__CALENDAR__ORGANIZATIONS__TKO__CALENDAR=TKO-äly
AGENT_MCP__CALENDAR__ORGANIZATIONS__TKO__SOURCES=https://members.tko-aly.fi
AGENT_MCP__CALENDAR__ORGANIZATIONS__TKO__IGNORE=gurula smash,board game weekly
AGENT_MCP__CALENDAR__ORGANIZATIONS__TKO__INSTRUCTIONS="Copy title, description and location as written on the members site."
# AGENT_MCP__CALENDAR__ORGANIZATIONS__TKO__SCHEDULING_CALENDAR=ai scheduling
# AGENT_MCP__CALENDAR__ORGANIZATIONS__TKO__ESTIMATED_END_PREFIX=[#]
# AGENT_MCP__CALENDAR__ORGANIZATIONS__TKO__DEFAULT_DURATION_MINUTES=120
# AGENT_MCP__CALENDAR__ORGANIZATIONS__TKO__SEND_UPDATES=none
